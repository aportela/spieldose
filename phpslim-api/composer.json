{
  "name": "aportela/spieldose",
  "description": "an application for streaming music hosted on your own server",
  "type": "project",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "alex",
      "email": "766f6964+github@gmail.com"
    }
  ],
  "homepage": "https://github.com/aportela/spieldose",
  "config": {
    "sort-packages": true,
    "process-timeout": 0
  },
  "require": {
    "php": ">=8.4",
    "aportela/db-browser-wrapper": "^1.1",
    "aportela/db-wrapper": "^2.1",
    "aportela/lastfm-wrapper": "^2.3",
    "aportela/mediawiki-wrapper": "^2.0",
    "aportela/musicbrainz-wrapper": "^3.3",
    "aportela/remote-thumbnail-cache-wrapper": "^2.1",
    "aportela/scraper-lyrics": "^1.2",
    "aportela/simple-fs-cache": "^1.1",
    "firebase/php-jwt": "^6.11",
    "james-heinrich/getid3": "^1.9",
    "monolog/monolog": "^3.9",
    "php-di/php-di": "^7.1",
    "ramsey/uuid": "^4.9",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.15",
    "slim/twig-view": "^3.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.66",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Spieldose\\": "Spieldose"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testdox",
    "fix": "vendor/bin/php-cs-fixer fix Spieldose",
    "stan": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit 1G",
    "start": "php -S 127.0.0.1:8081 -t public public/cliserver.php"
  }
}
